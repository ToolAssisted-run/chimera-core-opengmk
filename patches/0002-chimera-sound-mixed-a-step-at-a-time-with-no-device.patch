+[package]
+name = "udon"
+version = "0.0.1"
+authors = ["Adam <classygopher@gmail.com>"]
+edition = "2018"
+description = "udon (https://github.com/Adamcake/udon) without its audio devices: the sources, mixer and decoders only, for Chimera's core"
+license = "GPL-2.0-only"
+
+[features]
+default = []
+wav = []
+serde-derives = ["serde"]
+
+[dependencies]
+serde = { version = "1.0", features = ["derive", "rc"], optional = true }
