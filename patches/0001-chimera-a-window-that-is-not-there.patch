+[package]
+name = "ramen"
+version = "0.0.3"
+edition = "2021"
+description = "Stands in for the windowing crate ramen in Chimera's core: no window exists, nothing here does anything. Only the types and calls OpenGMK's emulator makes."
+license = "GPL-2.0-only"
+
+[dependencies]
