 // Makes a pseudorandom integer. Only used for seeding, such as in randomize().
+// In Chimera's core the machine's own sequence (set_machine_seed) answers: a
+// machine that draws on the host's randomness could not be replayed.
+static mut MACHINE_SEED: u64 = 0x9E37_79B9_7F4A_7C15;
+
+/// Starts the sequence `randomize()` and a new game's first seed are drawn from.
+pub fn set_machine_seed(seed: u64) {
+    unsafe { MACHINE_SEED = seed }
+}
+
 fn rand_int() -> i32 {
-    // TODO: Use uninit_array() and array_assume_init() when stabilized (will require v1.78.X+ tho)
-    let mut bytes = std::mem::MaybeUninit::<[u8; 4]>::uninit();
-    let _ = unsafe { getrandom::getrandom(&mut *bytes.as_mut_ptr()) };
-    i32::from_le_bytes(unsafe { bytes.assume_init() })
+    // splitmix64 over the machine's own state, which a savestate carries
+    unsafe {
+        MACHINE_SEED = MACHINE_SEED.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = MACHINE_SEED;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        (z ^ (z >> 31)) as i32
+    }
 }
