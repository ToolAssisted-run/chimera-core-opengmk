+//! OpenGMK's GameMaker 8 runner as a library, for Chimera's core: no window,
+//! no sound device, no recording interface. The core (waterbox/guest in the
+//! core's repository) builds a Game from an executable and calls `frame`.
+
+pub mod action;
+pub mod asset;
+pub mod game;
+pub mod gml;
+pub mod handleman;
+pub mod input;
+pub mod instance;
+pub mod instancelist;
+pub mod math;
+pub mod memfs;
+pub mod render;
+pub mod tile;
+pub mod types;
+pub mod util;
+
+pub use game::{Game, GameClock, PlayType};
