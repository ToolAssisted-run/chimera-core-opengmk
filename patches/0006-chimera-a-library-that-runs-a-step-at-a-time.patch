--- /dev/null
+++ b/gm8emulator/src/memfs.rs
@@ -0,0 +1,253 @@
+//! The files a game writes and reads, kept in the machine's own memory.
+//!
+//! A game saves with file_text_open_write, ini_open, file_bin_open and the
+//! like. In Chimera's core those files are never on a disk: they live here,
+//! so a savestate carries them, a replay writes them again exactly, and the
+//! core can list them for Export Save Data. A file that was not written here
+//! is read from the files the project mounted (the game's own folder).
+//!
+//! The calls and flags are the standard library's (`File`, `OpenOptions`), so
+//! the code that used those needs no change but its imports.
+
+use std::{
+    collections::BTreeMap,
+    io::{self, Read, Seek, SeekFrom, Write},
+};
+
+/// Name (as the game wrote it, with `/` for `\` and without a leading `./`) to
+/// contents. A sorted map: what the core lists never depends on an address.
+static mut FILES: BTreeMap<String, Vec<u8>> = BTreeMap::new();
+
+#[allow(static_mut_refs)]
+fn files() -> &'static mut BTreeMap<String, Vec<u8>> {
+    unsafe { &mut FILES }
+}
+
+fn text(path: &impl AsRef<std::path::Path>) -> String {
+    path.as_ref().to_string_lossy().into_owned()
+}
+
+fn key(path: &str) -> String {
+    let p = path.replace('\\', "/");
+    let mut p = p.as_str();
+    while let Some(rest) = p.strip_prefix("./") {
+        p = rest;
+    }
+    p.to_string()
+}
+
+/// The files the game has written, by name.
+pub fn written() -> Vec<(String, Vec<u8>)> {
+    files().iter().map(|(k, v)| (k.clone(), v.clone())).collect()
+}
+
+/// Puts a file as the game would have written it (the save data of an earlier
+/// session).
+pub fn put(path: &str, contents: Vec<u8>) {
+    files().insert(key(path), contents);
+}
+
+/// Whether the game has written the file, or the project mounted it.
+pub fn exists(path: impl AsRef<std::path::Path>) -> bool {
+    let path = text(&path);
+    files().contains_key(&key(&path)) || std::path::Path::new(&path).is_file()
+}
+
+pub fn read(path: impl AsRef<std::path::Path>) -> io::Result<Vec<u8>> {
+    let path = text(&path);
+    match files().get(&key(&path)) {
+        Some(data) => Ok(data.clone()),
+        None => std::fs::read(&path),
+    }
+}
+
+pub fn remove(path: impl AsRef<std::path::Path>) -> io::Result<()> {
+    files().remove(&key(&text(&path)));
+    Ok(())
+}
+
+pub fn rename(from: impl AsRef<std::path::Path>, to: impl AsRef<std::path::Path>) -> io::Result<()> {
+    let data = read(&from)?;
+    files().remove(&key(&text(&from)));
+    files().insert(key(&text(&to)), data);
+    Ok(())
+}
+
+pub fn copy(from: impl AsRef<std::path::Path>, to: impl AsRef<std::path::Path>) -> io::Result<u64> {
+    let data = read(&from)?;
+    let n = data.len() as u64;
+    files().insert(key(&text(&to)), data);
+    Ok(n)
+}
+
+#[derive(Clone, Default)]
+pub struct OpenOptions {
+    read: bool,
+    write: bool,
+    append: bool,
+    create: bool,
+    create_new: bool,
+    truncate: bool,
+}
+
+impl OpenOptions {
+    pub fn new() -> Self {
+        Self::default()
+    }
+    pub fn read(&mut self, v: bool) -> &mut Self {
+        self.read = v;
+        self
+    }
+    pub fn write(&mut self, v: bool) -> &mut Self {
+        self.write = v;
+        self
+    }
+    pub fn append(&mut self, v: bool) -> &mut Self {
+        self.append = v;
+        self
+    }
+    pub fn create(&mut self, v: bool) -> &mut Self {
+        self.create = v;
+        self
+    }
+    pub fn create_new(&mut self, v: bool) -> &mut Self {
+        self.create_new = v;
+        self
+    }
+    pub fn truncate(&mut self, v: bool) -> &mut Self {
+        self.truncate = v;
+        self
+    }
+
+    pub fn open(&self, path: impl AsRef<std::path::Path>) -> io::Result<File> {
+        let path = text(&path);
+        let path = path.as_str();
+        let k = key(path);
+        let there = files().contains_key(&k);
+        if self.create_new && (there || exists(path)) {
+            return Err(io::Error::from(io::ErrorKind::AlreadyExists));
+        }
+        if !there {
+            if self.create || self.create_new {
+                files().insert(k.clone(), Vec::new());
+            } else {
+                // not written: a file the project brought, read-only
+                if self.write || self.append {
+                    return Err(io::Error::from(io::ErrorKind::NotFound));
+                }
+                let data = std::fs::read(path)?;
+                files().insert(k.clone(), data);
+                return Ok(File { key: k, pos: 0, read: true, write: false, append: false, mounted: true });
+            }
+        }
+        if self.truncate && self.write {
+            files().get_mut(&k).unwrap().clear();
+        }
+        Ok(File { key: k, pos: 0, read: self.read, write: self.write || self.append, append: self.append, mounted: false })
+    }
+}
+
+#[derive(Debug)]
+pub struct File {
+    key: String,
+    pos: u64,
+    read: bool,
+    write: bool,
+    append: bool,
+    /// copied in from the project's files to be read: not the game's to keep
+    mounted: bool,
+}
+
+pub struct Metadata {
+    len: u64,
+}
+impl Metadata {
+    pub fn len(&self) -> u64 {
+        self.len
+    }
+}
+
+impl File {
+    pub fn open(path: impl AsRef<std::path::Path>) -> io::Result<File> {
+        OpenOptions::new().read(true).open(path)
+    }
+    pub fn create(path: impl AsRef<std::path::Path>) -> io::Result<File> {
+        OpenOptions::new().write(true).create(true).truncate(true).open(path)
+    }
+    pub fn set_len(&mut self, len: u64) -> io::Result<()> {
+        if !self.write {
+            return Err(io::Error::from(io::ErrorKind::PermissionDenied));
+        }
+        files().entry(self.key.clone()).or_default().resize(len as usize, 0);
+        Ok(())
+    }
+    pub fn metadata(&self) -> io::Result<Metadata> {
+        Ok(Metadata { len: files().get(&self.key).map_or(0, |d| d.len() as u64) })
+    }
+}
+
+impl Drop for File {
+    fn drop(&mut self) {
+        // a project file read through here was never the game's: do not keep it
+        if self.mounted {
+            files().remove(&self.key);
+        }
+    }
+}
+
+impl Read for File {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        if !self.read {
+            return Err(io::Error::from(io::ErrorKind::PermissionDenied));
+        }
+        let data = match files().get(&self.key) {
+            Some(d) => d,
+            None => return Ok(0),
+        };
+        let start = (self.pos as usize).min(data.len());
+        let n = buf.len().min(data.len() - start);
+        buf[..n].copy_from_slice(&data[start..start + n]);
+        self.pos += n as u64;
+        Ok(n)
+    }
+}
+
+impl Write for File {
+    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        if !self.write {
+            return Err(io::Error::from(io::ErrorKind::PermissionDenied));
+        }
+        let data = files().entry(self.key.clone()).or_default();
+        if self.append {
+            self.pos = data.len() as u64;
+        }
+        let start = self.pos as usize;
+        if data.len() < start {
+            data.resize(start, 0);
+        }
+        let overlap = (data.len() - start).min(buf.len());
+        data[start..start + overlap].copy_from_slice(&buf[..overlap]);
+        data.extend_from_slice(&buf[overlap..]);
+        self.pos += buf.len() as u64;
+        Ok(buf.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+impl Seek for File {
+    fn seek(&mut self, to: SeekFrom) -> io::Result<u64> {
+        let len = files().get(&self.key).map_or(0, |d| d.len() as i64);
+        let new = match to {
+            SeekFrom::Start(n) => n as i64,
+            SeekFrom::End(n) => len + n,
+            SeekFrom::Current(n) => self.pos as i64 + n,
+        };
+        if new < 0 {
+            return Err(io::Error::from(io::ErrorKind::InvalidInput));
+        }
+        self.pos = new as u64;
+        Ok(self.pos)
+    }
+}
