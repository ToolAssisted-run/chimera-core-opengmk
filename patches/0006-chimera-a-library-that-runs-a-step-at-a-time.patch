+    /// Chimera's core: gets the game ready to run its first frame (what `run`
+    /// does before its loop).
+    pub fn chimera_start(&mut self) -> Result<(), Box<dyn std::error::Error>> {
+        self.init()?;
+        self.chimera_scene_change()?;
+        Ok(())
+    }
+
+    /// Does what the end of a step does with a scene change; false when the
+    /// game has ended.
+    fn chimera_scene_change(&mut self) -> Result<bool, Box<dyn std::error::Error>> {
+        match self.scene_change {
+            Some(SceneChange::Room(id)) => self.load_room(id)?,
+            Some(SceneChange::Restart) => self.restart()?,
+            Some(SceneChange::End) => {
+                self.run_game_end_events()?;
+                return Ok(false);
+            },
+            Some(SceneChange::Load(ref mut path)) => {
+                let path = std::mem::take(path);
+                self.load_gm_save(path)?
+            },
+            None => (),
+        }
+        Ok(true)
+    }
+
+    /// Chimera's core: one step of the game, the body of `run`'s loop without
+    /// the window, the frame limiter or the host's clock. The caller has set
+    /// the controls through `set_input`, which is called after the mouse has
+    /// moved on from the last step. False when the game has ended.
+    pub fn chimera_step(
+        &mut self,
+        set_input: impl FnOnce(&mut Input),
+    ) -> Result<bool, Box<dyn std::error::Error>> {
+        self.input.mouse_step();
+        set_input(&mut self.input);
+        self.frame()?;
+        if !self.chimera_scene_change()? {
+            return Ok(false);
+        }
+        if self.close_requested {
+            self.run_game_end_events()?;
+            return Ok(false);
+        }
+        let duration = Duration::from_nanos(1_000_000_000 / self.room.speed.max(1) as u64);
+        if let GameClock::SpoofedNanos(t) = &mut self.clock {
+            *t += duration.as_nanos();
+        }
+        self.fps = self.room.speed;
+        self.frame_counter += 1;
+        Ok(true)
+    }
