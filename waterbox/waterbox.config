    "axes": [
      {
        "name": "Mouse X",
        "min": 0,
        "max": 8191,
        "neutral": 4096,
        "header": "mX"
      },
      {
        "name": "Mouse Y",
        "min": 0,
        "max": 8191,
        "neutral": 4096,
        "header": "mY"
      }
    ],
    "_comment_axes": "The pointer is normalised across this range and scaled to the game's window inside the core, because a game decides its window size and this file cannot know it. Bound window-relative (WMouse), since the game's window is the picture."
  },
  "settings": [
    {
      "name": "startTime",
      "display": "setting.starttime",
      "type": "datetime",
      "min": 0,
      "max": 4102444800,
      "default": 1262304000,
      "description": "setting.starttime.about"
    },
    {
      "name": "randomSeed",
      "display": "setting.randomseed",
      "type": "int",
      "min": 0,
      "max": 2147483647,
      "default": 0,
      "description": "setting.randomseed.about"
    }
  ],
