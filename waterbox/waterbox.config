{
  "coreName": "OpenGMK",
  "systemId": "GameMaker8",
  "systemNames": {
    "GameMaker8": "GameMaker 8"
  },
  "_system_note": "OpenGMK, the open source runner for games made with GameMaker 8: the game is the player's own .exe, which the project brings in its game slot. The core carries no game.",
  "kind": "game",
  "author": "The OpenGMK Project Developers (OpenGMK/OpenGMK); chimera core by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-opengmk",
  "runsOn": [
    "windows-x86_64",
    "linux-x86_64",
    "macos-x86_64"
  ],
  "romFile": "game",
  "deterministic": true,
  "memoryLayoutMiB": [
    512,
    16,
    16,
    256,
    1024
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. A game's pictures and sounds are unpacked into the heap when it starts (a large GameMaker game is a few hundred megabytes of them), and Mesa's buffers and the software OpenGL's textures share the mmap area. Only the pages a game touches cost anything.",
  "video": {
    "_comment": "The game's window as the game draws it, at the size the game asks for, through Mesa's softpipe inside the core, so the picture is the same on every machine. Capacity here is the largest window worth allowing; the live size comes from GetVideoWidth and GetVideoHeight.",
    "width": 1920,
    "height": 1200,
    "getBgra": "GetVideoBgra",
    "vsyncNumerator": 30,
    "vsyncDenominator": 1,
    "_comment_vsync": "A fallback only: a GameMaker room carries its own speed (steps a second) and the core reports it through GetVsyncNumerator."
  },
  "audio": {
    "_comment": "OpenGMK's own mixer, run for one step of the game at a time: 44.1 kHz stereo. samplesPerFrame is capacity: 44100 divided by the room's speed per step, so a room at 1 step a second is the worst case.",
    "rate": 44100,
    "samplesPerFrame": 44100,
    "channels": 2,
    "get": "GetAudio"
  },
  "extensions": {
    ".exe": "GameMaker8"
  },
  "input": {
    "name": "Keyboard and Mouse",
    "_comment": "Mouse Left/Middle/Right, then the keyboard row by row as it sits on a desk. The two axes are the pointer across the game's window. Buttons are levels; the core turns level changes into the key and mouse presses the game reads at the start of each step. The wire order is generated by waterbox/input-table.py.",
